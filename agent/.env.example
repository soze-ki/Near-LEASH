# Copy to agent/.env. Never commit .env or key files.
ANTHROPIC_API_KEY=sk-ant-...
NEAR_NETWORK=testnet
# Owner account (full key in ~/.near-credentials/testnet/<owner>.json, as near-cli stores it)
OWNER_ACCOUNT=you.testnet
# Guardrail contract account (created by `npm run deploy` as guardrail.<owner>)
GUARDRAIL_ACCOUNT=guardrail.you.testnet
# MPC signer contract
MPC_ACCOUNT=v1.signer-prod.testnet
# Agent function-call key, written by `npm run deploy` to agent/.agent-key.json; or set explicitly:
# AGENT_PRIVATE_KEY=ed25519:...
# Base Sepolia RPC for broadcasting signed txs
EVM_RPC_URL=https://sepolia.base.org
# 1Click (mainnet only; optional JWT lowers fees)
ONECLICK_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
